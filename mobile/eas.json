{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.qwertymates.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.qwertymates.com"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.qwertymates.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.qwertymates.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-apk": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "production-local": {
      "extends": "production",
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      }
    },
    "huawei": {
      "extends": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.qwertymates.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.qwertymates.com",
        "EXPO_PUBLIC_DISTRIBUTION": "huawei-appgallery"
      }
    },
    "huawei-apk": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.qwertymates.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.qwertymates.com",
        "EXPO_PUBLIC_DISTRIBUTION": "huawei-appgallery"
      }
    },
    "huawei-local": {
      "extends": "huawei",
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      }
    },
    "preview-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./credentials/google-play-service-account.json",
        "track": "production",
        "releaseStatus": "completed",
        "changesNotSentForReview": false
      },
      "ios": {
        "ascAppId": "6798004708",
        "appleTeamId": "2VBX9WG5H9"
      }
    },
    "open-testing": {
      "android": {
        "serviceAccountKeyPath": "./credentials/google-play-service-account.json",
        "track": "beta"
      }
    },
    "internal": {
      "android": {
        "serviceAccountKeyPath": "./credentials/google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
