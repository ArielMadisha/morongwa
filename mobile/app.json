{
  "expo": {
    "name": "Qwertymates",
    "slug": "morongwa-mobile",
    "scheme": "qwertymates",
    "version": "1.3.39",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fafafa"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qwertymates.app",
      "buildNumber": "8",
      "appleTeamId": "2VBX9WG5H9",
      "icon": "./assets/ios-icon.png",
      "infoPlist": {
        "CFBundleDisplayName": "Qwertymates",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Qwertymates uses the camera to take photos and videos for posts, statuses, and QwertyTV, and for video calls with other users.",
        "NSMicrophoneUsageDescription": "Qwertymates uses the microphone for voice and video calls, and when you record video or audio for posts and QwertyMusic.",
        "NSPhotoLibraryUsageDescription": "Qwertymates needs access to your photos and videos to create Wall and QwertyTV posts (images, video, Qwertz, cover art) and to set your profile picture.",
        "NSPhotoLibraryAddUsageDescription": "Qwertymates may save photos you take or choose (for example your profile picture) to your library when you export your own content. The app does not download other creators' audio or video to the device.",
        "NSLocationWhenInUseUsageDescription": "Qwertymates uses your location to verify runner arrival at the delivery address for errands, and to show nearby food and grocery stores when you allow it."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.qwertymates",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "backgroundColor": "#fafafa",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ]
    },
    "extra": {
      "brandDisplayName": "Qwertymates",
      "webTvLegacyPathPrefix": "/morongwa-tv",
      "apiUrl": "https://api.qwertymates.com/api",
      "socketUrl": "https://api.qwertymates.com",
      "turnUrls": "turn:165.227.237.142:3478?transport=udp,turns:165.227.237.142:5349?transport=tcp",
      "eas": {
        "projectId": "686960ed-6d34-446e-9872-eeafe4dfe5f1"
      }
    },
    "owner": "qwertymates",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a",
              "x86",
              "x86_64"
            ]
          }
        }
      ],
      "./plugins/withAndroidDeviceCompatibility.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#0EA5E9",
          "defaultChannel": "shop-orders"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Qwertymates needs access to your photos and videos to create Wall and QwertyTV posts (images, video, Qwertz, cover art) and to set your profile picture.",
          "cameraPermission": "Qwertymates uses the camera to take photos and videos for posts, statuses, and QwertyTV, and for video calls with other users."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Qwertymates uses your location to verify runner arrival at the delivery address for errands, and to show nearby food and grocery stores when you allow it."
        }
      ],
      "expo-font",
      "expo-screen-orientation",
      "expo-web-browser"
    ]
  }
}
