        },
        {
          "event": "timeout"
        },
        {
          "event": "deliveryFailure"
        }
      ],
      "type": "send-and-wait-for-reply"
    },
    {
      "name": "profile_pic_split",
      "properties": {
        "input": "{{widgets.ask_profile_pic.inbound.MediaUrl0}}",
        "offset": {
          "x": -120,
          "y": 730
        }
      },
      "transitions": [
        {
          "conditions": [
            {
              "arguments": [
                "{{widgets.ask_profile_pic.inbound.MediaUrl0}}"
              ],
              "friendly_name": "media missing",
              "type": "is_blank",
              "value": "Is Blank"
            }
          ],
          "event": "match",
          "next": "ask_profile_pic"
        },
        {
          "event": "noMatch",
          "next": "profile_pic_route_split"
        }
      ],
      "type": "split-based-on"
    },
    {
      "name": "profile_pic_route_split",
      "properties": {
        "input": "{{widgets.check_user.parsed.code}}",
        "offset": {
          "x": -120,
          "y": 830
        }
      },
      "transitions": [
        {
          "conditions": [
            {
              "arguments": [
                "{{widgets.check_user.parsed.code}}"
              ],
              "friendly_name": "existing user avatar update",
              "type": "equal_to",
              "value": "PROFILE_PICTURE_REQUIRED"
            }
          ],
          "event": "match",
          "next": "profile_picture_update_api"
        },
        {
          "event": "noMatch",
          "next": "ask_town"
        }
      ],
      "type": "split-based-on"
    },
    {
      "name": "ask_town",
      "properties": {
        "body": "Please enter town/area where you stay",
        "channel": "{{trigger.message.ChannelSid}}",
        "from": "{{flow.channel.address}}",
        "message_type": "custom",
        "offset": {
          "x": -120,
          "y": 880
        },
        "service": "{{trigger.message.InstanceSid}}",
        "timeout": "600"
      },
      "transitions": [
        {
          "event": "incomingMessage",
          "next": "register_api"
        },
        {
          "event": "timeout"
        },
        {
          "event": "deliveryFailure"
        }
      ],
      "type": "send-and-wait-for-reply"
    },
    {
      "name": "profile_picture_update_api",
      "properties": {
        "add_twilio_auth": false,
        "content_type": "application/x-www-form-urlencoded;charset=utf-8",
        "method": "POST",
        "offset": {
          "x": 120,
          "y": 1010
        },
        "parameters": [
          {
            "key": "phone",
            "value": "{{trigger.message.From}}"
          },
          {
            "key": "waId",
            "value": "{{trigger.message.WaId}}"
          },
          {
            "key": "avatarMediaUrl",
            "value": "{{widgets.ask_profile_pic.inbound.MediaUrl0}}"
          }
        ],
        "url": "https://api.qwertymates.com/api/wa/flow/profile-picture/update"
      },
      "transitions": [
        {
          "event": "success",
          "next": "check_user"
        },
        {
          "event": "failed",
          "next": "error_message"
        }
      ],
      "type": "make-http-request"
    },
    {
      "name": "register_api",
      "properties": {
        "add_twilio_auth": false,
        "content_type": "application/x-www-form-urlencoded;charset=utf-8",
        "method": "POST",
        "offset": {
          "x": -120,
          "y": 930
        },
