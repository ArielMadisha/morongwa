{
  "description": "Morongwa WhatsApp Flow v2 (template, clean labels)",
  "flags": {
    "allow_concurrent_calls": true
  },
  "initial_state": "Trigger",
  "states": [
    {
      "name": "Trigger",
      "properties": {
        "offset": {
          "x": 0,
          "y": 0
        }
      },
      "transitions": [
        {
          "event": "incomingMessage",
          "next": "check_user"
        },
        {
          "event": "incomingCall"
        },
        {
          "event": "incomingConversationMessage"
        },
        {
          "event": "incomingRequest"
        },
        {
          "event": "incomingParent"
        }
      ],
      "type": "trigger"
    },
    {
      "name": "check_user",
      "properties": {
        "add_twilio_auth": false,
        "content_type": "application/x-www-form-urlencoded;charset=utf-8",
        "method": "POST",
        "offset": {
          "x": 0,
          "y": 170
        },
        "parameters": [
          {
            "key": "phone",
            "value": "{{trigger.message.From}}"
          },
          {
            "key": "waId",
            "value": "{{trigger.message.WaId}}"
          },
          {
            "key": "accountSid",
            "value": "{{trigger.message.AccountSid}}"
          },
          {
            "key": "to",
            "value": "{{trigger.message.To}}"
          },
          {
            "key": "option",
            "value": "{{trigger.message.Body}}"
          }
        ],
        "url": "https://api.qwertymates.com/api/wa/flow/check-user"
      },
      "transitions": [
        {
          "event": "success",
          "next": "check_user_split"
        },
        {
          "event": "failed",
          "next": "error_message"
        }
      ],
      "type": "make-http-request"
    },
    {
      "name": "check_user_split",
      "properties": {
        "input": "{{widgets.check_user.parsed.code}}",
        "offset": {
          "x": 0,
          "y": 340
        }
      },
      "transitions": [
        {
          "conditions": [
            {
              "arguments": [
                "{{widgets.check_user.parsed.code}}"
              ],
              "friendly_name": "register start",
              "type": "equal_to",
              "value": "REGISTER_START"
            }
          ],
          "event": "match",
          "next": "ask_dob"
        },
        {
          "conditions": [
            {
              "arguments": [
                "{{widgets.check_user.parsed.code}}"
              ],
              "friendly_name": "new user",
              "type": "equal_to",
              "value": "USER_NOT_FOUND"
            }
          ],
          "event": "match",
          "next": "show_unregistered"
        },
        {
          "conditions": [
            {
              "arguments": [
                "{{widgets.check_user.parsed.code}}"
              ],
              "friendly_name": "missing avatar",
              "type": "equal_to",
              "value": "PROFILE_PICTURE_REQUIRED"
            }
          ],
          "event": "match",
          "next": "ask_profile_pic"
        },
        {
          "conditions": [
            {
              "arguments": [
                "{{widgets.check_user.parsed.code}}"
              ],
              "friendly_name": "welcome premenu via REST",
              "type": "equal_to",
              "value": "WELCOME_PREMENU_REST"
            }
          ],
          "event": "match",
          "next": "main_menu_rest_wait"
        },
        {
          "conditions": [
            {
              "arguments": [
                "{{widgets.check_user.parsed.code}}"
              ],
              "friendly_name": "ready",
              "type": "equal_to",
              "value": "USER_READY_18_PLUS"
            }
          ],
          "event": "match",
          "next": "main_menu"
        },
        {
          "conditions": [
            {
              "arguments": [
                "{{widgets.check_user.parsed.code}}"
              ],
              "friendly_name": "ready under18",
              "type": "equal_to",
              "value": "USER_READY_UNDER_18"
            }
          ],
          "event": "match",
          "next": "main_menu"
        },
        {
          "event": "noMatch",
          "next": "error_message"
        }
      ],
      "type": "split-based-on"
    },
    {
      "name": "show_unregistered",
      "properties": {
        "body": "{{widgets.check_user.parsed.message}}",
        "channel": "{{trigger.message.ChannelSid}}",
        "from": "{{flow.channel.address}}",
        "message_type": "custom",
        "offset": {
          "x": -470,
          "y": 520
        },
        "service": "{{trigger.message.InstanceSid}}",
        "timeout": "600"
      },
      "transitions": [
        {
          "event": "incomingMessage",
          "next": "ask_dob"
        },
        {
          "event": "timeout"
        },
        {
          "event": "deliveryFailure"
        }
      ],
      "type": "send-and-wait-for-reply"
    },
    {
      "name": "ask_full_name_menu",
      "properties": {
        "body": "{{widgets.main_menu_api.parsed.message}}",
        "channel": "{{trigger.message.ChannelSid}}",
        "from": "{{flow.channel.address}}",
        "message_type": "custom",
        "offset": {
          "x": -200,
          "y": 520
        },
        "service": "{{trigger.message.InstanceSid}}",
        "timeout": "600"
      },
      "transitions": [
        {
          "event": "incomingMessage",
          "next": "ask_dob"
        },
        {
          "event": "timeout"
        },
        {
          "event": "deliveryFailure"
        }
      ],
      "type": "send-and-wait-for-reply"
    },
    {
      "name": "ask_full_name_menu_rest",
      "properties": {
        "body": "{{widgets.main_menu_rest_api.parsed.message}}",
        "channel": "{{trigger.message.ChannelSid}}",
        "from": "{{flow.channel.address}}",
        "message_type": "custom",
        "offset": {
          "x": 80,
          "y": 520
        },
        "service": "{{trigger.message.InstanceSid}}",
        "timeout": "600"
      },
      "transitions": [
        {
          "event": "incomingMessage",
          "next": "ask_dob"
        },
        {
          "event": "timeout"
        },
        {
          "event": "deliveryFailure"
        }
      ],
      "type": "send-and-wait-for-reply"
    },
