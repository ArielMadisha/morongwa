    {
      "name": "main_menu_rest_split",
      "properties": {
        "input": "{{widgets.main_menu_rest_api.parsed.code}}",
        "offset": {
          "x": 520,
          "y": 940
        }
      },
      "transitions": [
        {
          "conditions": [
            {
              "arguments": [
                "{{widgets.main_menu_rest_api.body}}"
              ],
              "friendly_name": "sell silent fallback from raw body",
              "type": "contains",
              "value": "SELL_INFO_SILENT"
            }
          ],
          "event": "match",
          "next": "main_menu_rest_wait"
        },
        {
          "conditions": [
            {
              "arguments": [
                "{{widgets.main_menu_rest_api.parsed.code}}"
              ],
              "friendly_name": "sell silent (REST sends content)",
              "type": "equal_to",
              "value": "SELL_INFO_SILENT"
            }
          ],
          "event": "match",
          "next": "main_menu_rest_wait"
        },
        {
          "conditions": [
            {
              "arguments": [
                "{{widgets.main_menu_rest_api.parsed.code}}"
              ],
              "friendly_name": "sell info",
              "type": "equal_to",
              "value": "SELL_INFO"
            }
          ],
          "event": "match",
          "next": "sell_info_rest_response"
        },
        {
          "conditions": [
            {
              "arguments": [
