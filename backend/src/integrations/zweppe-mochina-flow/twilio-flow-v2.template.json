            "value": "{{trigger.message.WaId}}"
          },
          {
            "key": "name",
            "value": "{{widgets.ask_name.inbound.Body}}"
          },
          {
            "key": "dateOfBirth",
            "value": "{{widgets.ask_dob.inbound.Body}}"
          },
          {
            "key": "password",
            "value": "{{widgets.ask_password.inbound.Body}}"
          },
          {
            "key": "avatarMediaUrl",
            "value": "{{widgets.ask_profile_pic.inbound.MediaUrl0}}"
          },
          {
            "key": "townArea",
            "value": "{{widgets.ask_town.inbound.Body}}"
          }
