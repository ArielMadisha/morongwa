# Agent instruction inbox (IMAP poll — see npm run agent:poll-instructions)
IMAP_HOST=mail.qwertymates.com
IMAP_PORT=993
IMAP_SECURE=1
IMAP_USER=agent@qwertymates.com
IMAP_PASS=your-agent-mailbox-password
AGENT_INSTRUCTION_ALLOWLIST=instructions@qwertymates.com,instructions1@qwertymates.com,administrator@qwertymates.com
AGENT_INSTRUCTION_AUTO_REPLY=1
AGENT_INSTRUCTION_MAX_ATTACHMENT_BYTES=10485760
AGENT_INSTRUCTION_SMTP_USER=agent@qwertymates.com
AGENT_INSTRUCTION_SMTP_PASS=your-agent-mailbox-password
