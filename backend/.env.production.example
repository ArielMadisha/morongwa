# Morongwa - Errand Runner Marketplace
# Production Environment Configuration
# IMPORTANT: Update all sensitive values before deploying to production

PORT=5000
NODE_ENV=production

# ============================================
# MongoDB Atlas (Production Cluster)
# ============================================
# Replace with your production MongoDB Atlas URI
# Create a dedicated production cluster and user for security
MONGO_URI=

# ============================================
# JWT Authentication
# ============================================
# Generate a strong, random secret key for production
# Use: openssl rand -base64 32
JWT_SECRET="generate-a-strong-random-secret-key-for-production"

# ============================================
# Frontend & Backend URLs
# ============================================
FRONTEND_URL=https://www.morongwa.com
BACKEND_URL=https://api.morongwa.com

# ============================================
# SMTP Email Configuration (Gmail, SendGrid, etc.)
# ============================================
# For production, use a dedicated email service
# Gmail: Enable 2FA and generate App Password
# SendGrid: Use API key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-production-email@gmail.com
SMTP_PASS=your-app-specific-password

# Mailer selection: set to `ethereal` in development to use Nodemailer's test account
# For production, leave empty or use a real SMTP provider and set SMTP_* variables
MAILER=

# Marketplace order alert emails (ADDITIONAL — in-app + Messenger flows unchanged)
# Original primary inbox(es); comma-separated. Leave unset to only use ORDERS_INBOX_CC / regional.
# ORDERS_INBOX_EMAIL=your-original-orders-inbox@example.com
# Always merged in addition to ORDERS_INBOX_EMAIL (default includes orders@qwertymates.com)
ORDERS_INBOX_CC=orders@qwertymates.com

# Platform ops — additive SMTP copy of admin realtime alerts (in-app alerts unchanged)
PLATFORM_OPS_EMAIL=administrator@qwertymates.com

# Department inboxes — additive SMTP only; original flows unchanged
DISPUTES_INBOX_EMAIL=disputes@qwertymates.com
HR_INBOX_EMAIL=hr@qwertymates.com
ORDERS_INBOX_BOTSWANA=botswana@qwertymates.com
ORDERS_INBOX_ZAMBIA=zambia@qwertymates.com
# Staff WhatsApp for new-order alerts (comma-separated). Default +27660442139. Empty disables.
ORDERS_OPS_WHATSAPP=+27660442139
# Staff WhatsApp for WhatsApp Jobs → Onboarding Agent applications. Always includes +27661294468; extras optional.
# ONBOARDING_OPS_WHATSAPP=+27661294468

# Alternative: SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=sg.your-sendgrid-api-key

# ============================================
# PayGate - South African Payment Gateway
# ============================================
# Get these from your PayGate merchant account
# https://www.paygate.co.za
PAYGATE_ID=your-production-paygate-id
PAYGATE_SECRET=your-production-paygate-secret
PAYGATE_URL=https://secure.paygate.co.za/payweb3/process.trans
# Flat ZAR fee added to every PayGate card transaction (default 5). Set to 0 to disable.
PAYGATE_FLAT_FEE_ZAR=5

# ============================================
# Logging
# ============================================
LOG_LEVEL=warn

# ============================================
# Sponsored ads / advertiser prepaid billing (web + surfaces)
# ============================================
# Percentage of each billed event gross attributed as "platform" (remainder → partner/incentive bucket in reports).
AD_PLATFORM_SHARE_PCT=85
# Max impression events per viewer key (userExternalId / phone hash) per ad per hour before soft-ignore.
AD_IMPRESSION_MAX_PER_USER_PER_HOUR=40

# ============================================
# Admin Configuration (used by seed-admin script)
# ============================================
# Set these when running npm run seed-admin; never commit real values
ADMIN_EMAIL=admin@morongwa.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ============================================
# CORS & Security
# ============================================
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=https://www.morongwa.com,https://morongwa.com

# ============================================
# Twilio (OTP, wallet SMS, money requests)
# ============================================
# Same config for: registration OTP, QR payment verification, money request notifications
# From https://console.twilio.com - Account SID and Auth Token
# SMS: Buy a number at Phone Numbers → Manage → Buy a number
# WhatsApp: Use sandbox for testing, or approved WhatsApp Business number for production
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+1234567890
# Optional: Botswana SMS sender (+267) when parent SA number cannot reach +267 handsets
# TWILIO_SMS_FROM_BW=+267XXXXXXXXX
# Optional: Lesotho SMS sender (+266)
# TWILIO_SMS_FROM_LS=+266XXXXXXXXX
# REQUIRED for reliable food/grocery merchant SMS last-resort to South African handsets.
# US TWILIO_SMS_FROM (+1…) → ZA (+27) often ends undelivered (Twilio error 30003).
# WhatsApp sender TWILIO_WHATSAPP_FROM (+27…) is NOT an SMS-capable Twilio number — do not reuse it.
# Buy a ZA mobile (SMS-enabled) in Twilio Console, then set:
# TWILIO_SMS_FROM_ZA=+2760XXXXXXXX
# Steps: DOCS/FOOD_MERCHANT_SMS_ZA_SENDER.md — then npm run sync:wa-twilio-env-remote
# Optional: use a Twilio Messaging Service for better SMS deliverability (used only when no regional From matches)
# TWILIO_SMS_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=+1234567890

# REQUIRED for food/grocery merchant order alerts outside the 24h WhatsApp session window.
# Meta-approved Twilio Content template SID (utility). Variables: 1=storeName, 2=orderNumber, 3=buyerName, 4=itemSummary.
# Create/submit: npm run wa:order-alert-content -- --write-env
# Check Meta status: npm run wa:order-alert-content -- --status HX...
# Sync to production: npm run sync:wa-twilio-env-remote
# Freeform WhatsApp often fails with Twilio 63016 without this fallback — missing SID is a production blocker.
# TWILIO_WA_ORDER_ALERT_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional second WhatsApp Business sender (e.g. Botswana +267). REST follow-ups use the same `from` as the inbound `To` when Studio passes `To` on /api/wa-flow/* requests.
# For one shared line for Botswana + South Africa users, set TWILIO_WHATSAPP_FROM to that number and leave TWILIO_WHATSAPP_FROM_BW unset (or set FROM_BW to the exact same E.164 as FROM — duplicate routes are skipped).
# TWILIO_WHATSAPP_FROM_BW=+267XXXXXXXXX
# TWILIO_WA_BW_ACCOUNT_SID=
# TWILIO_WA_BW_AUTH_TOKEN=
#
# Optional third sender (Lesotho +266): same semantics as Botswana. When inbound `To` is missing but the user is `266…`,
# outbound REST sends use this profile so chats stay on the Lesotho business line once configured.
# TWILIO_WHATSAPP_FROM_LS=+266XXXXXXXXX
# TWILIO_WA_LS_ACCOUNT_SID=
# TWILIO_WA_LS_AUTH_TOKEN=
#
# Optional generic multi-country overrides (advanced). JSON array: each row has whatsappFrom, dialPrefixes, optional accountSid/authToken.
# Rows are evaluated before legacy BW/LS env. If dialPrefixes contains "267" or "266", that suppresses TWILIO_WHATSAPP_FROM_BW/_LS for that digit prefix only.
# Example (server env single line escaped):
# TWILIO_WA_REGIONAL_SENDERS_JSON=[{"whatsappFrom":"+260XXXXXXXX","dialPrefixes":["260"],"accountSid":"AC..."}]

# Studio: WhatsApp chatbot flow (FW…). Set this so pushTwilioFlowV2.mjs updates the SAME flow your sender uses instead of creating a new orphan flow.
# TWILIO_STUDIO_FLOW_SID=

# ============================================
# Twilio Voice SDK (Morongwa WebRTC → PSTN)
# ============================================
# Outbound caller ID — must be a Twilio voice-capable number.
# TWILIO_VOICE_FROM=+27XXXXXXXXX
# VOICE_ENABLED=1
# VOICE_CONNECT_FEE_ZAR=0.35
# VOICE_MIN_WALLET_BALANCE_ZAR=5
# VOICE_RATES_JSON=
# Auto-refresh Twilio wholesale pricing → exports/twilio-voice-pricing-latest.json (daily + on API startup)
# VOICE_PRICING_SYNC_ENABLED=1
# VOICE_PRICING_SYNC_CRON=0 4 * * *
# VOICE_PRICING_SYNC_TZ=Africa/Johannesburg
# VOICE_PRICING_SYNC_STARTUP_DELAY_MS=60000
# API key + TwiML app (required for Voice SDK — not plain REST callback):
# TWILIO_API_KEY_SID=SK...
# TWILIO_API_KEY_SECRET=...
# TWILIO_VOICE_APPLICATION_SID=AP...
# TwiML app Voice Request URL (set in Twilio console or provisionTwilioVoiceApp.mjs):
#   POST {BACKEND_URL}/api/voice/twiml/client-outbound
# Status callback: {BACKEND_URL}/api/voice/webhook/status

# Signed WhatsApp deep links (GET /api/wa/g/:token → 302 to wa.me). Stops tampering with ?text= payloads.
# If unset, JWT_SECRET is used when it is at least 16 characters. Prefer a dedicated secret in production.
# WA_LINK_SIGNING_SECRET=
# Public base for links in bot messages (default: {BACKEND_URL}/api/wa). Use a short branded domain if you add a reverse proxy.
# WA_LINK_PUBLIC_BASE=https://api.qwertymates.com/api/wa
# Comma-separated extra hostnames allowed in signed "share" links (default: FRONTEND_URL host + qwertymates.com).
# WA_PUBLIC_SHARE_HOSTS=www.example.com,example.com

# Optional: Strong secret for OTP hashing (default used if not set)
# OTP_SECRET=generate-a-strong-random-secret

# Optional: Block additional premium prefixes (comma-separated, digits only)
# Built-in: SA 087/089, US 900, UK 0870/0871/09xx, UZ 99899541 (virtual SMS farm). Add more as needed.
# OTP_BLOCK_PREFIXES=2787,2789,1900

# Registration abuse (bulk bots / virtual numbers)
# REGISTRATION_BLOCK_PHONE_PREFIXES=99899541,998900
# REGISTRATION_MAX_PER_PHONE_PREFIX_PER_DAY=2
# REGISTRATION_HIGH_RISK_COUNTRIES=UZ

# ============================================
# Rate Limiting
# ============================================
# Requests per 15 minutes per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Session & Cookie Security
# ============================================
SESSION_SECRET=generate-a-strong-random-session-secret
SECURE_COOKIES=true
SAME_SITE_COOKIES=strict

# ============================================
# AWS S3 (Optional - for file uploads)
# ============================================
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=morongwa-production-bucket
# AWS_S3_REGION=eu-west-1

# ============================================
# Sentry (Error Tracking - Optional)
# ============================================
# SENTRY_DSN=https://your-sentry-key@sentry.io/project-id

# ============================================
# Database Backups (Optional)
# ============================================
# BACKUP_SCHEDULE=daily
# BACKUP_RETENTION_DAYS=30

# ============================================
# Content Moderation (Sightengine - Optional)
# ============================================
# Block nudity and explicit content; report blocked uploads to admin.
# Get free API keys at https://sightengine.com
# When not set and CONTENT_MODERATION_REQUIRED=1, image uploads are rejected.
# SIGHTENGINE_API_USER=your-api-user
# SIGHTENGINE_API_SECRET=your-api-secret
# CONTENT_MODERATION_REQUIRED=1
# CONTENT_MODERATION_BLOCK_SUGGESTIVE=1

# ============================================
# Feature Flags (Optional)
# ============================================
# FEATURE_PAYMENT_ENABLED=true
# FEATURE_NOTIFICATIONS_ENABLED=true
# FEATURE_CHAT_ENABLED=true

# ============================================
# Morongwa messenger -> standalone mchat sync bridge (optional)
# ============================================
# Safe by default: bridge is disabled unless explicitly enabled.
# When enabled, backend forwards message/presence/read events to mchat asynchronously.
# MCHAT_SYNC_BRIDGE_ENABLED=false
# MCHAT_SYNC_BRIDGE_URL=https://mchat.your-domain.com/api/v1/sync/events
# MCHAT_SYNC_SHARED_SECRET=replace-with-strong-shared-secret
# MCHAT_SYNC_TENANT_ID=qwertymates
# MCHAT_SYNC_TIMEOUT_MS=2500

# ============================================
# Ask MacGyver AI (POST /api/macgyver/ask — optional OpenAI)
# ============================================
# OPENAI_API_KEY=
# MACGYVER_OPENAI_MODEL=gpt-4o-mini
# MACGYVER_OPENAI_TIMEOUT_MS=22000
# Open web when Qwertymates search has no hits: Tavily (best) → Wikipedia → DuckDuckGo instant answer
# TAVILY_API_KEY=
# MACGYVER_WEB_SEARCH_DISABLED=1
# How long learned answers (Mongo) are reused before refreshing (ms). Default 86400000 = 24h
# MACGYVER_LEARNED_MAX_AGE_MS=86400000

# ============================================
# LiveKit Cloud (1:1 calls, Live Rooms, Audio Rooms, Qwertz Live)
# ============================================
# JWT mint only — LIVEKIT_API_SECRET must NEVER go in frontend env.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Optional token TTL (seconds, default 3600):
# LIVEKIT_TOKEN_TTL_SECONDS=3600

# ============================================
# Qwertz Video Editing Suite (standalone service)
# ============================================
# Phase 1: proxy /api/qwertz/* to Qwertz Node service (FFmpeg on that host)
QWERTZ_API_URL=http://localhost:4100
QWERTZ_API_KEY=

# ============================================
# WebRTC TURN (Recommended secure setup)
# ============================================
# Comma-separated TURN URIs for clients.
TURN_URLS=turn:your-turn-host:3478?transport=udp,turns:your-turn-host:5349?transport=tcp
# Shared secret for coturn REST auth (use-auth-secret=1, static-auth-secret=<same value>).
# This allows backend to mint short-lived TURN credentials per user.
TURN_SHARED_SECRET=replace-with-strong-random-secret
# Optional TTL for temporary TURN credentials (seconds).
TURN_TTL_SECONDS=3600
# Enforce temporary-only TURN credentials (disable static fallback).
TURN_ENFORCE_EPHEMERAL=1
# Legacy fallback (only used when TURN_SHARED_SECRET is missing; avoid in production).
# TURN_USERNAME=
# TURN_PASSWORD=

# ============================================
# Live streaming (RTMP ingest → HLS playback)
# ============================================
# Admin visibility: GET /admin/live/settings (see /admin/live in the web admin).
# HLS playlist base served to browsers (HTTPS, no trailing slash — used to build …/STREAMKEY.m3u8).
# LIVESTREAM_HLS_PUBLIC_BASE=https://live.example.com/hls
# Alternate name supported by livestream helper:
# HLS_PLAYBACK_BASE_URL=https://live.example.com/hls
# OBS "Server" host (no scheme): rtmp://<this>/<app>/<streamKey>
# LIVESTREAM_RTMP_PUBLIC_HOST=live.example.com
# Or derive host + app from a full ingest URL:
# RTMP_INGEST_URL=rtmp://live.example.com/live
# LIVESTREAM_RTMP_APP=live
#
# Same-VPS Docker media stack (nginx-rtmp + HLS on :8081): see repo infra/media-server/docker-compose.yml
# Then point Nginx Proxy Manager → http://127.0.0.1:8081 (path /hls). Open tcp/1935 for RTMP publishers.

# ============================================
# QwertyTV linear channel — optional FFmpeg restream (VOD playout → RTMP → HLS)
# ============================================
# When set, the API process spawns ffmpeg to push the *current* library file at the *computed* playhead
# (wall-clock for fixed slots; anchored elapsed time for queue items) into your RTMP app (e.g. nginx-rtmp).
# Requires ffmpeg on PATH (or set TV_CHANNEL_FFMPEG_BIN). Omit URL to disable.
# TV_CHANNEL_FFMPEG_RTMP_URL=rtmp://127.0.0.1:1935/live/qwertytv-linear
# Poll interval (ms) for playout state / drift checks.
# TV_CHANNEL_FFMPEG_POLL_MS=2000
# Restart ffmpeg when API position and estimated stream position differ by more than this (ms).
# TV_CHANNEL_FFMPEG_RESYNC_DRIFT_MS=4000
# Optional periodic restart even if drift is low (ms); 0 = disable.
# TV_CHANNEL_FFMPEG_RESYNC_PERIOD_MS=120000
# TV_CHANNEL_FFMPEG_BIN=ffmpeg
# TV_CHANNEL_FFMPEG_LOGLEVEL=warning

# ============================================
# Facebook Page → QwertyTV wall ingest (3 bots, scheduled SAST)
# ============================================
# Does NOT post to your Qwertymates Facebook Page — imports to /wall (TVPost) only.
# App: https://developers.facebook.com/apps/ (Qwertymates app id in Meta dashboard)
# FACEBOOK_APP_ID=344616052245151
# FACEBOOK_APP_SECRET=
# User token from Graph API Explorer with pages_read_engagement + pages_show_list (NOT public_profile only).
# Third-party Pages (Duma FM, GOAL, …) also need App Review: Page Public Content Access.
# FACEBOOK_PAGE_ACCESS_TOKEN=
# Local check: npm run facebook-tv:probe
# FACEBOOK_TV_INGEST_ENABLED=1

# ============================================
# QwertyHub → Qwertymates Facebook Page auto-post (marketplace products)
# ============================================
# When a product goes live on QwertyHub, post photo + link to your Page:
# https://www.facebook.com/profile.php?id=100069041477611
# Token needs pages_manage_posts + pages_read_engagement + pages_show_list (see Meta screenshot).
# Use Page access token from Graph API Explorer or /me/accounts after authorizing your user.
# FACEBOOK_QWERTYMATES_PAGE_ID=100069041477611
# FACEBOOK_MARKETPLACE_AUTO_POST=1
# FACEBOOK_QWERTYMATES_PAGE_ACCESS_TOKEN=   # optional — falls back to FACEBOOK_PAGE_ACCESS_TOKEN
# Local check: npm run facebook:marketplace-probe
# Test post:   npm run facebook:marketplace-probe -- --product=<mongoProductId>
# Admin API:   POST /api/admin/facebook-ingest/marketplace-post/:productId

# FACEBOOK_TV_INGEST_TZ=Africa/Johannesburg
# User account that owns imported TV posts (create e.g. username qwerty_news)
# FACEBOOK_TV_CREATOR_USERNAME=qwerty_news
# Sightengine required — ingest fails closed if not configured (CONTENT_MODERATION_BLOCK_SUGGESTIVE=1 recommended)

# ============================================
# Mobile Android force-update policy (public GET /api/mobile/android-update-policy)
# ============================================
# MOBILE_ANDROID_MIN_VERSION=1.3.23
# MOBILE_ANDROID_MIN_VERSION_CODE=75
# MOBILE_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.qwertymates
# MOBILE_ANDROID_FORCE_MESSAGE=A required update is available. Please update Qwertymates from Google Play to continue.
# iOS force-update (listing live — set FORCE=true when blocking outdated builds)
# MOBILE_IOS_MIN_VERSION=1.3.23
# MOBILE_IOS_MIN_BUILD_NUMBER=1
# MOBILE_IOS_STORE_URL=https://apps.apple.com/app/id6798004708
# MOBILE_IOS_FORCE_UPDATE=false
# MOBILE_IOS_FORCE_MESSAGE=A required update is available. Please update Qwertymates from the App Store to continue.
