# Copy to deploy-server.secrets in the project root (gitignored).
# NEVER put a real password or private key in this .example file (it may be committed).
# NEVER commit deploy-server.secrets.
#
#   copy deploy-server.secrets.example deploy-server.secrets
#
# --- SSH (pick password and/or key; many VPS setups disable password login) ---
#
# Option A — password (no spaces around =):
#   DEPLOY_SSH_PASSWORD=YourRealPassword
#
# Or keep the VPS password only in backend/.env as DEPLOY_SECRET=... (deploy scripts load that file).
#
# Option B — OpenSSH private key (repo-relative path from monorepo root, or absolute):
#   DEPLOY_SSH_PRIVATE_KEY_PATH=.ssh/morongwa_deploy_ed25519
# Optional if the key file is passphrase-protected:
#   DEPLOY_SSH_PRIVATE_KEY_PASSPHRASE=your-key-passphrase
#
# Option C — PowerShell for one session only:
#   $env:DEPLOY_SSH_PASSWORD='YourReal'
#   $env:DEPLOY_SSH_PRIVATE_KEY_PATH="$env:USERPROFILE\.ssh\id_ed25519"
#   cd backend; npm run deploy:production

# Realtime infra (TURN + livestream) for mobile
# Use your public host/IP if no DNS yet (e.g. 165.227.237.142)
TURN_REALM=qwertymates.com
TURN_USERNAME=morongwa_turn_user
TURN_PASSWORD=replace-with-long-random-secret

# Livestream playback host/path (nginx serves /hls from this path)
PUBLIC_APP_DOMAIN=qwertymates.com
LIVESTREAM_HLS_DOMAIN=qwertymates.com
LIVESTREAM_TLS_DOMAIN=qwertymates.com
LIVESTREAM_HLS_PATH=/var/www/morongwa-hls
LIVESTREAM_HLS_PORT=8081
